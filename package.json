{
  "name": "agentpages",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint:docs": "node scripts/check-markdown.ts",
    "lint:spec": "node scripts/check-requirements.ts",
    "lint:api": "pnpm -r exec api-extractor run",
    "api:update": "pnpm -r exec api-extractor run --local",
    "check:upstream": "bash scripts/check-upstream.sh",
    "test:mutation": "stryker run",
    "lint": "oxlint --deny-warnings",
    "lint:source": "node scripts/check-source.ts",
    "lint:duplicates": "jscpd",
    "test": "vitest run",
    "lint:packages": "pnpm -r exec publint --strict && pnpm -r exec attw --pack . --profile esm-only",
    "lint:unused": "knip",
    "size": "size-limit",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm lint:source && pnpm lint:duplicates &&pnpm test && pnpm test:mutation && pnpm lint:packages && pnpm lint:unused && pnpm lint:docs && pnpm lint:spec && pnpm lint:api && pnpm size",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "size-limit": [
    {
      "path": "packages/client/dist/index.js",
      "limit": "5 kB"
    },
    {
      "path": "packages/host/dist/index.js",
      "limit": "10 kB"
    },
    {
      "name": "protocol: METHODS and TOOLS only",
      "path": "packages/protocol/dist/index.js",
      "import": "{ METHODS, TOOLS }",
      "limit": "500 B"
    },
    {
      "name": "protocol: error helpers of a client",
      "path": "packages/protocol/dist/index.js",
      "import": "{ fromJsonRpcError, failure, toJsonRpcError }",
      "limit": "3.5 kB"
    }
  ],
  "devDependencies": {
    "@agentpages/protocol": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.7",
    "ajv": "^8.20.0",
    "fast-check": "^4.11.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "oxc-parser": "^0.160.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
