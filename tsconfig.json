{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "scripts",
    "lint",
    "tests",
    "*.config.ts",
    "*.config.js",
    ".dependency-cruiser.mjs",
    "packages/*/tsdown.config.ts"
  ]
}
