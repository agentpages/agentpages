{
  "name": "@agentpages/sqlite",
  "version": "0.0.0",
  "description": "A storage adapter that keeps a Store in a SQLite file",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentpages/agentpages.git",
    "directory": "packages/sqlite"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.16"
  },
